{
  "name": "casemove",
  "version": "1.0.0",
  "productName": "Casemove",
  "main": "out/main/main.js",
  "description": "Counter-Strike 2 Storage unit manager that helps you move items in bulk without the clicking. ",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "lint": "cross-env NODE_ENV=development eslint . --cache --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "electron-dev": "electron .",
    "electron-trace": "electron --trace-warnings ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "Casemove",
    "appId": "xyz.norbjert.casemove",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "out/**",
      "!out/**/*.map"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Casemove${arch === 'arm64' ? '-arm64' : ''}.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "artifactName": "Casemove-Setup.exe",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "sign": "./sign.js"
      }
    },
    "linux": {
      "artifactName": "Casemove.AppImage",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "norbjert",
      "repo": "casemove"
    }
  },
  "homepage": "https://github.com/norbjert/casemove",
  "author": {
    "name": "norbjert"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@heroicons/react": "^1.0.6",
    "@svgr/core": "^6.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/history": "4.7.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^16.11.6",
    "@types/react": "^17.0.33",
    "@types/react-dom": "^17.0.10",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.3.2",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.2",
    "core-js": "^3.19.0",
    "cross-env": "^7.0.3",
    "detect-port": "^1.3.0",
    "dotenv": "^16.0.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.9.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "electron-winstaller": "^5.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-erb": "^4.0.3",
    "eslint-plugin-compat": "^7.0.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-promise": "^5.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "7.0.4",
    "jsdom": "^29.0.2",
    "lint-staged": "^11.2.6",
    "opencollective-postinstall": "^2.0.3",
    "postcss": "^8.3.11",
    "prettier": "^2.4.1",
    "react-refresh-typescript": "^2.0.2",
    "rimraf": "^3.0.2",
    "tailwindcss": "^4.2.2",
    "ts-node": "10.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.4.4",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@electron/remote": "^2.0.4",
    "@headlessui/react": "^1.6.6",
    "@node-steam/vdf": "^2.2.0",
    "@redux-beacon/google-analytics": "^1.2.3",
    "@reduxjs/toolkit": "^1.7.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@xmldom/xmldom": "^0.9.6",
    "axios": "^1.7.0",
    "bytebuffer": "^5.0.1",
    "chart.js": "^3.8.0",
    "chartjs-plugin-datalabels": "^2.0.0",
    "electron-debug": "^3.2.0",
    "electron-dl": "^3.3.0",
    "electron-log": "^5.4.3",
    "electron-redux": "^1.5.4",
    "electron-store": "^8.0.1",
    "electron-updater": "^6.3.9",
    "fernet": "^0.3.3",
    "find-process": "^1.4.7",
    "globaloffensive": "^3.3.0",
    "history": "4.x.x",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.0",
    "react-chartjs-2": "^4.3.1",
    "react-dom": "^17.0.2",
    "react-qr-code": "^2.0.15",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.0",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.1",
    "regenerator-runtime": "^0.14.1",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.1",
    "steam-user": "^4.28.1",
    "update-electron-app": "^2.0.1"
  },
  "engines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "overrides": {
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3",
    "qs": "^6.14.1",
    "protobufjs": "^7.5.5",
    "chalk": "^4.1.2",
    "rimraf": "^3.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
