{
  "name": "casemove",
  "productName": "Casemove",
  "description": "Counter-Strike 2 Storage unit manager that helps you move items in bulk without the clicking. ",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir src",
    "lint": "cross-env NODE_ENV=development eslint . --cache --ext .js,.jsx,.ts,.tsx",
    "prepare": "ts-node ./.erb/scripts/clean.js dist && npm run build",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish always",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts && opencollective-postinstall",
    "start": "ts-node-dev ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electron -r ts-node/register/transpile-only ./src/main/main.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "electron-dev": "electron .",
    "electron-trace": "electron --trace-warnings ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "Casemove",
    "appId": "xyz.norbjert.casemove",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Casemove${arch === 'arm64' ? '-arm64' : ''}.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "artifactName": "Casemove-Setup.exe",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "sign": "./sign.js"
      }
    },
    "linux": {
      "artifactName": "Casemove.AppImage",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "norbjert",
      "repo": "casemove"
    }
  },
  "homepage": "https://github.com/norbjert/casemove",
  "author": {
    "name": "norbjert"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "testPathIgnorePatterns": [
      "release/app/dist"
    ],
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "setupFilesAfterEnv": [
      "./.erb/scripts/jest.setup.ts"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@heroicons/react": "^1.0.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/core": "^6.2.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^16.3.2",
    "@types/history": "4.7.9",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.15",
    "@types/node": "^16.11.6",
    "@types/react": "^17.0.33",
    "@types/react-dom": "^17.0.10",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.3.2",
    "@types/react-test-renderer": "^19.0.0",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-env": "^1.16.3",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.2",
    "core-js": "^3.19.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.5.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^1.3.0",
    "dotenv": "^16.0.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.9.0",
    "electron-devtools-installer": "^3.2.0",
    "electron-winstaller": "^5.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-erb": "^4.0.3",
    "eslint-plugin-compat": "^7.0.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jest": "^25.2.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-promise": "^5.1.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^11.2.6",
    "mini-css-extract-plugin": "^2.4.3",
    "opencollective-postinstall": "^2.0.3",
    "postcss": "^8.3.11",
    "postcss-loader": "^6.2.0",
    "prettier": "^2.4.1",
    "react-refresh": "^0.14.0",
    "react-refresh-typescript": "^2.0.2",
    "react-test-renderer": "^19.0.0",
    "rimraf": "^3.0.2",
    "sass": "^1.85.0",
    "sass-loader": "^12.3.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "terser-webpack-plugin": "^5.2.4",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.2.6",
    "ts-node": "10.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.4.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.60.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@electron/remote": "^2.0.4",
    "@headlessui/react": "^1.6.6",
    "@node-steam/vdf": "^2.2.0",
    "@redux-beacon/google-analytics": "^1.2.3",
    "@reduxjs/toolkit": "^1.7.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@xmldom/xmldom": "^0.9.6",
    "axios": "^1.7.0",
    "bytebuffer": "^5.0.1",
    "chart.js": "^3.8.0",
    "chartjs-plugin-datalabels": "^2.0.0",
    "electron-debug": "^3.2.0",
    "electron-dl": "^3.3.0",
    "electron-log": "^4.4.8",
    "electron-redux": "^1.5.4",
    "electron-store": "^8.0.1",
    "electron-updater": "^6.3.9",
    "fernet": "^0.3.3",
    "find-process": "^1.4.7",
    "globaloffensive": "^3.1.0",
    "history": "4.x.x",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.0",
    "react-chartjs-2": "^4.2.0",
    "react-dom": "^17.0.2",
    "react-qr-code": "^2.0.15",
    "react-redux": "^7.2.6",
    "react-router-dom": "^5.3.0",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.1",
    "regenerator-runtime": "^0.13.9",
    "steam-session": "^1.1.1",
    "steam-totp": "^2.1.1",
    "steam-user": "^4.28.1",
    "update-electron-app": "^2.0.1"
  },
  "engines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "overrides": {
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3",
    "qs": "^6.14.1",
    "protobufjs": "^7.5.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
