{
  "name": "casemove",
  "version": "1.0.0",
  "productName": "Casemove",
  "main": "out/main/main.js",
  "description": "Counter-Strike 2 Storage unit manager that helps you move items in bulk without the clicking. ",
  "scripts": {
    "build": "electron-vite build",
    "package": "npm run build && electron-builder",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "electron-dev": "electron .",
    "electron-trace": "electron --trace-warnings .",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "Casemove",
    "appId": "xyz.norbjert.casemove",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "out/**",
      "!out/**/*.map"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Casemove${arch === 'arm64' ? '-arm64' : ''}.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signtoolOptions": {
        "sign": "./sign.js"
      }
    },
    "linux": {
      "artifactName": "${productName}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "norbjert",
      "repo": "casemove"
    },
    "nsis": {
      "artifactName": "Casemove-Setup.exe"
    },
    "portable": {
      "artifactName": "Casemove-Portable.exe"
    }
  },
  "homepage": "https://github.com/norbjert/casemove",
  "author": {
    "name": "norbjert",
    "email": "norbjert@users.noreply.github.com"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "core-js": "^3.49.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.9.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "7.0.4",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "postcss": "^8.3.11",
    "prettier": "^3.8.3",
    "rimraf": "^3.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@node-steam/vdf": "^2.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@xmldom/xmldom": "^0.9.10",
    "axios": "^1.15.2",
    "bytebuffer": "^5.0.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.0.0",
    "electron-debug": "^3.2.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "find-process": "^2.1.1",
    "globaloffensive": "^3.3.0",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.0.0",
    "regenerator-runtime": "^0.14.1",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.1",
    "steam-user": "^4.29.3"
  },
  "engines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  },
  "collective": {
    "url": "https://opencollective.com/electron-react-boilerplate-594"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "overrides": {
    "redux": "^5.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3",
    "qs": "^6.14.1",
    "protobufjs": "^7.5.5",
    "chalk": "^4.1.2",
    "rimraf": "^3.0.2",
    "minimatch": "^9.0.7",
    "ip-address": ">=10.1.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
